### Example .env for local development (DO NOT COMMIT secrets)
# Copy to `.env.local` or set environment variables in your host (do NOT use VITE_ prefix for server secrets)

# Client-safe (public) keys - VITE_ prefix is required to expose to client builds
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secret (do NOT expose this to client builds)
# Set this in your deployment environment (e.g., Vercel/Netlify) as `SUPABASE_SERVICE_KEY`
# SUPABASE_SERVICE_KEY=
